{
  "name": "kleos",
  "version": "0.1.0",
  "description": "SVG cards for your GitHub profile that show where your open-source work goes: PRs, issues and discussions by repo, owner and ecosystem.",
  "keywords": [
    "github",
    "github-profile",
    "profile-readme",
    "readme-stats",
    "svg",
    "contributions",
    "open-source",
    "github-action",
    "cli"
  ],
  "homepage": "https://github.com/garysassano/kleos#readme",
  "bugs": "https://github.com/garysassano/kleos/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garysassano/kleos.git"
  },
  "license": "MIT",
  "author": "Gary Sassano",
  "type": "module",
  "bin": {
    "kleos": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm check:md && pnpm test",
    "check:md": "prettier --check \"**/*.md\"",
    "fetch": "node src/cli/fetch.ts",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "gallery": "node src/cli/gallery.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  }
}
